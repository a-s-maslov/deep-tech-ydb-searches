# Copy to .env. Do not commit the resulting file.
WORKLOAD_CONFIG=./config/workload.local.json
WORKLOAD_DATA=./data/output/smoke-50000
WORKLOAD_METRICS_PORT=9091
MONITORING_NETWORK=chaos-monitoring
WORKLOAD_DOCKERFILE=Dockerfile.local

# Container-to-host endpoint for the local Podman setup. Host-run commands use
# grpc://localhost:2136/local from workload.local.json instead.
YDB_CONNECTION_STRING=grpc://host.containers.internal:2136/local
YDB_NODE_ADDRESS_OVERRIDE=host.containers.internal

# Stand credentials only. Anonymous local YDB leaves these empty.
YDB_TOKEN=
YDB_CA_FILE=
